# ── Supabase (Public – safe for client) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase (Server-only – never expose to client) ──
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_PROJECT_ID=your-project-id

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Car Pool
NEXT_PUBLIC_DEFAULT_LOCALE=de

# ── Map Provider Abstraction (server-side) ──
# Choose one: maplibre (free OSM), mapbox, google
MAP_PROVIDER=maplibre
# Only if using Mapbox/Google – keep server-side and proxy via /api/maps/*
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# ── Email (optional, for magic-link / notifications) ──
# Resend, Postmark, or SMTP – proxied via Supabase Auth or server route
RESEND_API_KEY=
EMAIL_FROM=noreply@carpool.de

# ── EAS / Expo ──
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
EXPO_PUBLIC_APP_URL=http://localhost:3000
